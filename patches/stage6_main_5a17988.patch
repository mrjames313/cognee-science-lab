@@ -0,0 +1,48 @@
+"""Export the implementation schema; cross-record/runtime checks remain Python checks."""
+
+import json
+from pathlib import Path
+
+from .models import IdentitySource
+
+
+def schema():
+    result = IdentitySource.model_json_schema()
+    result["$schema"] = "https://json-schema.org/draft/2020-12/schema"
+    result["title"] = "Cognee identity source — implementation draft 0.1"
+    result["description"] = (
+        "Schema generated from runtime models. Cross-reference, exact text/range, "
+        "dependency, UUID-use and publication checks also run in Python."
+    )
+    result["properties"]["entity_constructions"]["description"] = (
+        "Each entry declares an Entity this source intends to retain, including supported "
+        "singletons and existing endpoints, and supplies minimal creation values. All required "
+        "endpoints need entries. Existing nodes bypass property writes; a recipe does not "
+        "authorize reconstructing a missing reasoning input or retired intent."
+    )
+    result["properties"]["variant_assignments"][
+        "description"
+    ] = "Relationships independently established by this source, not a cached identity-graph walk."
+    result["properties"]["inputs"][
+        "description"
+    ] = "Shared inputs/locators. Per-record input_refs declare actual reasoning dependencies."
+    definitions = result["$defs"]
+    definitions["SourceTextInput"]["properties"]["text_sha256"][
+        "description"
+    ] = "SHA-256 lowercase hex of exact extracted document string encoded as UTF-8, without normalization."
+    definitions["TextSpanInput"]["properties"]["text_sha256"][
+        "description"
+    ] = "SHA-256 lowercase hex of UTF-8 document_text[start:end], excluding offsets and parent digest."
+    definitions["CorpusObjectInput"]["properties"]["content_sha256"][
+        "description"
+    ] = "SHA-256 lowercase hex of RFC 8785 JCS UTF-8 of selected supplied field/value object; missing fields fail."
+    definitions["SavedRecordInput"]["properties"]["content_sha256"][
+        "description"
+    ] = "SHA-256 lowercase hex of JCS UTF-8 complete supplied record, excluding enclosing source/revision."
+    return result
+
+
+if __name__ == "__main__":
+    target = Path("schemas/cognee_identity_source_schema_draft.json")
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(json.dumps(schema(), indent=2, ensure_ascii=False) + "\n")
diff --git a/src/cognee_lab/identity/storage.py b/src/cognee_lab/identity/storage.py
new file mode 100644
index 0000000..2cf7162
--- /dev/null
+++ b/src/cognee_lab/identity/storage.py
@@ -0,0 +1,314 @@
+"""Portable project bookkeeping through Cognee's configured relational sessions."""
+
+import json
+from datetime import datetime, timezone
+from uuid import NAMESPACE_URL, uuid4, uuid5
+
+from sqlalchemy import Integer, String, Text, select, update
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column
+
+from .models import IdentitySource
+from .validation import IntentError
+
+
+class Base(DeclarativeBase):
+    pass
+
+
+class Publication(Base):
+    __tablename__ = "lab_identity_publications"
+    dataset: Mapped[str] = mapped_column(String(36), primary_key=True)
+    source: Mapped[str] = mapped_column(String(36), primary_key=True)
+    revision: Mapped[int] = mapped_column(Integer)
+    verified_revision: Mapped[int] = mapped_column(Integer, default=0)
+    state: Mapped[str] = mapped_column(String(16))
+    attempt: Mapped[str] = mapped_column(String(36))
+    description: Mapped[str] = mapped_column(Text)
+    plan: Mapped[str] = mapped_column(Text)
+
+
+class Writer(Base):
+    __tablename__ = "lab_identity_writers"
+    dataset: Mapped[str] = mapped_column(String(36), primary_key=True)
+    owner: Mapped[str | None] = mapped_column(String(36), nullable=True)
+
+
+class RecoveryEvent(Base):
+    __tablename__ = "lab_identity_recovery_events"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    dataset: Mapped[str] = mapped_column(String(36))
+    source: Mapped[str] = mapped_column(String(36))
+    attempt: Mapped[str] = mapped_column(String(36))
+    details: Mapped[str] = mapped_column(Text)
+
+
+def now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def encode(value) -> str:
+    return json.dumps(value, ensure_ascii=False, allow_nan=False, sort_keys=True)
+
+
+class RecordStore:
+    def __init__(self, session_factory=None):
+        if session_factory is None:
+            from cognee.infrastructure.databases.relational import get_relational_engine
+
+            session_factory = get_relational_engine().get_async_session
+        self.session_factory = session_factory
+
+    async def initialize(self):
+        async with self.session_factory() as session:
+            connection = await session.connection()
+            await connection.run_sync(Base.metadata.create_all)
+            await session.commit()
+
+    async def rows(self, dataset=None):
+        async with self.session_factory() as session:
+            statement = select(Publication)
+            if dataset is not None:
+                statement = statement.where(Publication.dataset == str(dataset))
+            rows = (await session.execute(statement)).scalars().all()
+            return [
+                dict(
+                    dataset=r.dataset,
+                    source=r.source,
+                    revision=r.revision,
+                    verified_revision=r.verified_revision,
+                    state=r.state,
+                    attempt=r.attempt,
+                    description=r.description,
+                    plan=json.loads(r.plan),
+                )
+                for r in rows
+            ]
+
+    async def events(self, dataset):
+        async with self.session_factory() as session:
+            rows = (
+                (
+                    await session.execute(
+                        select(RecoveryEvent).where(
+                            RecoveryEvent.dataset == str(dataset)
+                        )
+                    )
+                )
+                .scalars()
+                .all()
+            )
+            return [json.loads(r.details) for r in rows]
+
+    async def begin(
+        self,
+        source: IdentitySource,
+        *,
+        expected_revision: int,
+        plan: dict,
+        method="publish",
+        origin="runtime",
+    ) -> str:
+        dataset, sid = str(source.dataset_id), str(source.identity_data_id)
+        # Serialize project writers across datasets in shared physical storage.
+        # Native writers outside this coordinator are not covered by this lock.
+        lock_scope = "shared-identity-publication"
+        async with self.session_factory() as session:
+            if await session.get(Writer, lock_scope) is None:
+                session.add(Writer(dataset=lock_scope, owner=None))
+                try:
+                    await session.commit()
+                except IntegrityError:
+                    await session.rollback()
+        attempt = str(uuid4())
+        async with self.session_factory() as session:
+            locked = await session.execute(
+                update(Writer)
+                .where(Writer.dataset == lock_scope, Writer.owner.is_(None))
+                .values(owner=attempt)
+            )
+            if locked.rowcount != 1:
+                raise IntentError(
+                    "writer_busy", "Dataset has an active/abandoned project writer"
+                )
+            row = await session.get(Publication, (dataset, sid))
+            actual_revision = row.revision if row else 0
+            if actual_revision != expected_revision:
+                raise IntentError("stale_revision", "Saved revision changed")
+            if row and row.state == "pending":
+                raise IntentError(
+                    "pending_attempt",
+                    "Inspect abandoned pending publication explicitly",
+                )
+            payload = source.model_dump_json()
+            if row and source.revision == actual_revision:
+                if json.loads(payload) != json.loads(row.description):
+                    raise IntentError(
+                        "revision_reuse", "Changed description requires a new revision"
+                    )
+            elif source.revision != actual_revision + 1:
+                raise IntentError(
+                    "revision_sequence",
+                    "New description must advance exactly one revision",
+                )
+            if row is None:
+                row = Publication(dataset=dataset, source=sid, verified_revision=0)
+                session.add(row)
+            row.revision, row.state, row.attempt = source.revision, "pending", attempt
+            row.description, row.plan = payload, encode(plan)
+            # Recovery attempts are diagnostic links, not new incidents.
+            events = (
+                (
+                    await session.execute(
+                        select(RecoveryEvent).where(
+                            RecoveryEvent.dataset == dataset,
+                            RecoveryEvent.source == sid,
+                        )
+                    )
+                )
+                .scalars()
+                .all()
+            )
+            for event in events:
+                info = json.loads(event.details)
+                if info.get("resolved_at") is None:
+                    info.setdefault("recovery_attempts", []).append(
+                        {"attempt_id": attempt, "method": method, "started_at": now()}
+                    )
+                    event.details = encode(info)
+            plan.update(origin=origin, method=method)
+            row.plan = encode(plan)
+            await session.commit()
+        return attempt
+
+    async def fail(self, source, attempt, stage, error, *, origin=None) -> str:
+        dataset, sid = str(source.dataset_id), str(source.identity_data_id)
+        event_id = str(uuid5(NAMESPACE_URL, f"lab-recovery:{dataset}:{sid}:{attempt}"))
+        async with self.session_factory() as session:
+            row = await session.get(Publication, (dataset, sid))
+            if row is None or row.attempt != attempt:
+                raise IntentError("stale_attempt", "Failure belongs to another attempt")
+            row.state = "failed"
+            event = await session.get(RecoveryEvent, event_id)
+            if event is None:
+                prior = (
+                    (
+                        await session.execute(
+                            select(RecoveryEvent).where(
+                                RecoveryEvent.dataset == dataset,
+                                RecoveryEvent.source == sid,
+                            )
+                        )
+                    )
+                    .scalars()
+                    .all()
+                )
+                for candidate in prior:
+                    details = json.loads(candidate.details)
+                    if details.get("resolved_at") is None and any(
+                        a["attempt_id"] == attempt
+                        for a in details.get("recovery_attempts", [])
+                    ):
+                        event, event_id = candidate, candidate.id
+                        break
+            info = (
+                json.loads(event.details)
+                if event
+                else {
+                    "recovery_event_id": event_id,
+                    "dataset_id": dataset,
+                    "identity_data_id": sid,
+                    "original_data_id": str(
+                        source.inputs[source.original_input_ref].data_id
+                    ),
+                    "attempt_id": attempt,
+                    "intended_revision": source.revision,
+                    "last_verified_revision": row.verified_revision,
+                    "first_detected_at": now(),
+                    "origin": origin or json.loads(row.plan).get("origin", "runtime"),
+                    "runtime_profile": json.loads(row.plan).get("runtime_profile", {}),
+                    "operation": json.loads(row.plan).get("method", "publish"),
+                    "integration_version": "stage6-m0-m1",
+                    "resolved_at": None,
+                }
+            )
+            failure = dict(
+                stage=stage,
+                reason_code=getattr(error, "code", type(error).__name__),
+                message=str(error)[:800],
+            )
+            info["last_observed_at"] = now()
+            if info["attempt_id"] == attempt:
+                info.update(failure)
+            else:
+                for recovery in info.get("recovery_attempts", []):
+                    if recovery["attempt_id"] == attempt:
+                        recovery.update(failure, outcome="failed", finished_at=now())
+            if event is None:
+                session.add(
+                    RecoveryEvent(
+                        id=event_id,
+                        dataset=dataset,
+                        source=sid,
+                        attempt=attempt,
+                        details=encode(info),
+                    )
+                )
+            else:
+                event.details = encode(info)
+            await session.execute(
+                update(Writer)
+                .where(
+                    Writer.dataset == "shared-identity-publication",
+                    Writer.owner == attempt,
+                )
+                .values(owner=None)
+            )
+            await session.commit()
+        return event_id
+
+    async def complete(self, source, attempt):
+        dataset, sid = str(source.dataset_id), str(source.identity_data_id)
+        async with self.session_factory() as session:
+            result = await session.execute(
+                update(Publication)
+                .where(
+                    Publication.dataset == dataset,
+                    Publication.source == sid,
+                    Publication.revision == source.revision,
+                    Publication.attempt == attempt,
+                    Publication.state == "pending",
+                )
+                .values(state="current", verified_revision=source.revision)
+            )
+            if result.rowcount != 1:
+                raise IntentError(
+                    "stale_attempt", "Cannot acknowledge stale/nonpending attempt"
+                )
+            await session.execute(
+                update(Writer)
+                .where(
+                    Writer.dataset == "shared-identity-publication",
+                    Writer.owner == attempt,
+                )
+                .values(owner=None)
+            )
+            for event in (
+                await session.execute(
+                    select(RecoveryEvent).where(
+                        RecoveryEvent.dataset == dataset, RecoveryEvent.source == sid
+                    )
+                )
+            ).scalars():
+                info = json.loads(event.details)
+                if info.get("resolved_at") is None:
+                    info.update(
+                        resolved_at=now(),
+                        resolving_attempt=attempt,
+                        resolving_revision=source.revision,
+                        outcome="restored",
+                    )
+                    if info.get("recovery_attempts"):
+                        info["recovery_attempts"][-1]["outcome"] = "verified"
+                    event.details = encode(info)
+            await session.commit()
diff --git a/src/cognee_lab/identity/validation.py b/src/cognee_lab/identity/validation.py
new file mode 100644
index 0000000..fc808ab
--- /dev/null
+++ b/src/cognee_lab/identity/validation.py
@@ -0,0 +1,196 @@
+"""Exact input checks. No identity judgments or approximate substring matching."""
+
+from hashlib import sha256
+from typing import Any
+
+import rfc8785
+
+from .models import (
+    ChunkInput,
+    CorpusObjectInput,
+    IdentitySource,
+    SavedRecordInput,
+    SourceTextInput,
+    TextScope,
+    TextSpanInput,
+)
+
+
+class IntentError(ValueError):
+    """Intent cannot currently be published; code is suitable for diagnostics."""
+
+    def __init__(self, code: str, message: str):
+        self.code = code
+        super().__init__(message)
+
+
+def text_digest(text: str) -> str:
+    return sha256(text.encode("utf-8")).hexdigest()
+
+
+def object_digest(value: Any) -> str:
+    return sha256(rfc8785.dumps(value)).hexdigest()
+
+
+def map_chunks(document_text: str, chunks: list) -> dict[str, tuple[int, int]]:
+    """Use Cognee's exact tiling check, not a separate mapping algorithm."""
+    from cognee.modules.chunking.incremental_chunking import chunk_offsets
+
+    ordered = sorted(chunks, key=lambda c: c.chunk_index)
+    if len({c.chunk_index for c in ordered}) != len(ordered):
+        raise IntentError("chunk_mapping", "Duplicate chunk indexes")
+    if len({str(c.id) for c in ordered}) != len(ordered):
+        raise IntentError("chunk_mapping", "Duplicate chunk UUIDs")
+    try:
+        offsets = chunk_offsets(document_text, [c.text for c in ordered])
+    except ValueError as exc:
+        raise IntentError("chunk_mapping", str(exc)) from exc
+    except Exception as exc:
+        from cognee.modules.chunking.incremental_chunking import IncrementalPlanError
+
+        if isinstance(exc, IncrementalPlanError):
+            raise IntentError("chunk_mapping", str(exc)) from exc
+        raise
+    return {str(c.id): span for c, span in zip(ordered, offsets, strict=True)}
+
+
+async def validate_inputs(
+    source: IdentitySource,
+    *,
+    texts: dict[str, str],
+    chunks: dict[str, Any],
+    graph,
+    saved_record_reader=None,
+) -> None:
+    """Validate the current source and the union of actually consumed dependencies."""
+    used = {source.original_input_ref}
+    for record in [
+        *source.mention_groups.values(),
+        *source.mention_resolutions.values(),
+        *source.variant_assignments.values(),
+    ]:
+        used.update(record.input_refs)
+    for group in source.mention_groups.values():
+        used.add(group.document_ref)
+        used.update(group.chunk_refs)
+    for variant in source.variant_assignments.values():
+        if hasattr(variant.applicability, "document_ref"):
+            used.add(variant.applicability.document_ref)
+    for key in list(used):
+        item = source.inputs[key]
+        if isinstance(item, (ChunkInput, TextSpanInput)):
+            used.add(item.document_ref)
+
+    mappings = {}
+    for key in used:
+        item = source.inputs[key]
+        if isinstance(item, SourceTextInput):
+            if key not in texts or text_digest(texts[key]) != item.text_sha256:
+                raise IntentError("source_changed", f"Text missing/changed: {key}")
+            matching = [
+                c for c in chunks.values() if str(c.is_part_of.id) == str(item.data_id)
+            ]
+            if matching:
+                mappings[key] = map_chunks(texts[key], matching)
+
+    for key in used:
+        item = source.inputs[key]
+        if isinstance(item, SourceTextInput):
+            text = texts.get(key)
+            if text is None or text_digest(text) != item.text_sha256:
+                raise IntentError("source_changed", f"Text missing/changed: {key}")
+        elif isinstance(item, TextSpanInput):
+            text = texts[item.document_ref]
+            if (
+                item.end > len(text)
+                or text_digest(text[item.start : item.end]) != item.text_sha256
+            ):
+                raise IntentError("input_changed", f"Span missing/changed: {key}")
+        elif isinstance(item, CorpusObjectInput):
+            node = await graph.get_node(str(item.entity_id))
+            if node is None:
+                raise IntentError(
+                    "missing_reasoning_input", f"Corpus input missing: {key}"
+                )
+            if any(field not in node for field in item.selected_fields):
+                raise IntentError("input_changed", f"Corpus fields missing: {key}")
+            if (
+                object_digest({field: node[field] for field in item.selected_fields})
+                != item.content_sha256
+            ):
+                raise IntentError("input_changed", f"Corpus fields changed: {key}")
+        elif isinstance(item, SavedRecordInput):
+            if saved_record_reader is None:
+                raise IntentError(
+                    "unsupported_input", "A saved-record reader is required"
+                )
+            value, revision = await saved_record_reader(item)
+            if (
+                revision != item.representation_revision
+                or object_digest(value) != item.content_sha256
+            ):
+                raise IntentError("input_changed", f"Saved record changed: {key}")
+        elif isinstance(item, ChunkInput):
+            chunk = chunks.get(str(item.chunk_id))
+            parent = source.inputs[item.document_ref]
+            text = texts[item.document_ref]
+            if (
+                chunk is None
+                or str(chunk.is_part_of.id) != str(parent.data_id)
+                or item.end > len(text)
+                or chunk.text != text[item.start : item.end]
+            ):
+                raise IntentError(
+                    "chunk_mapping", f"Chunk missing or mapping changed: {key}"
+                )
+            if mappings.get(item.document_ref, {}).get(str(item.chunk_id)) != (
+                item.start,
+                item.end,
+            ):
+                raise IntentError(
+                    "chunk_mapping",
+                    f"Chunk range differs from ordered native mapping: {key}",
+                )
+
+    for group in source.mention_groups.values():
+        text = texts[group.document_ref]
+        for occurrence in group.occurrences:
+            if (
+                occurrence.end > len(text)
+                or text[occurrence.start : occurrence.end] != occurrence.text
+            ):
+                raise IntentError(
+                    "occurrence_changed", "Occurrence does not match document slice"
+                )
+        for key in group.chunk_refs:
+            chunk = source.inputs[key]
+            if not any(
+                o.start < chunk.end and chunk.start < o.end for o in group.occurrences
+            ):
+                raise IntentError(
+                    "context_marker", "Context-only chunk cannot own a mention marker"
+                )
+    for variant in source.variant_assignments.values():
+        scope = variant.applicability
+        if isinstance(scope, TextScope):
+            if any(r.end > len(texts[scope.document_ref]) for r in scope.ranges):
+                raise IntentError("scope_range", "Variant range outside document")
+
+
+def validate_uses(sources: list[IdentitySource]) -> None:
+    """Build a transient UUID-use view; singleton declarations count as reusable."""
+    mentions, reusable = {}, set()
+    for source in sources:
+        local_mentions = {g.entity_id for g in source.mention_groups.values()}
+        reusable.update(set(source.entity_constructions) - local_mentions)
+        for key, group in source.mention_groups.items():
+            identity = (source.identity_data_id, key)
+            if group.entity_id in mentions and mentions[group.entity_id] != identity:
+                raise IntentError(
+                    "incompatible_group", "Mention UUID belongs to another group"
+                )
+            mentions[group.entity_id] = identity
+    if set(mentions) & reusable:
+        raise IntentError(
+            "incompatible_use", "UUID used as both mention and reusable Entity"
+        )
