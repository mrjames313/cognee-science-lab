+                        (
+                            *triple,
+                            dict(
+                                edge.edge_properties,
+                                identity_contributions=encode(kept),
+                            ),
+                        )
+                    ]
+                )
+            if not wanted.get(triple):
+                retire_edges.append(EdgeIdentity(*triple))
