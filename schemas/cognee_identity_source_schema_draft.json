  "title": "Cognee identity source — implementation draft 0.1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema generated from runtime models. Cross-reference, exact text/range, dependency, UUID-use and publication checks also run in Python."
}
