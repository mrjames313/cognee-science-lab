      },
      "propertyNames": {
        "format": "uuid"
      },
      "title": "Entity Constructions",
      "type": "object",
      "description": "Each entry declares an Entity this source intends to retain, including supported singletons and existing endpoints, and supplies minimal creation values. All required endpoints need entries. Existing nodes bypass property writes; a recipe does not authorize reconstructing a missing reasoning input or retired intent."
    },
