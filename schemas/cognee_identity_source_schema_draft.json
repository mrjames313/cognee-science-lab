        "minLength": 1
      },
      "title": "Inputs",
      "type": "object",
      "description": "Shared inputs/locators. Per-record input_refs declare actual reasoning dependencies."
    },
    "producers": {
      "additionalProperties": {
        "$ref": "#/$defs/Producer"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Producers",
