# Cognee local single-user lab configuration


# Directly calling low-level DataPoint storage operations, so
# disable multi-user access control
ENABLE_BACKEND_ACCESS_CONTROL=false
REQUIRE_AUTHENTICATION=false

# Keep Cognee stat inside the directory tree so experiments are
# easy to modify / reset.  These directories are gitignored
SYSTEM_ROOT_DIRECTORY=/absolute/path/to/cognee-science-lab/.cognee_system
DATA_ROOT_DIRECTORY=/Users/michaeljames/projects/cognee-science-lab/.cognee_data
CACHE_ROOT_DIRECTORY=/Users/michaeljames/projects/cognee-science-lab/.cognee_cache

# OpenAI graph extraction
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.6-luna
LLM_API_KEY=YOUR_OPENAI_API_KEY
\
# NVIDIA embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=YOUR_NVIDIA_KEY
EMBEDDING_DIMENSIONS=1024

# The tokenizer selection will affect chunk sizing
HUGGINGFACE_TOKENIZER=BAAI/bge-m3